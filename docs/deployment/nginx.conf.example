server {
    listen 80;
    server_name _;

    root /var/www/bahi-khata;
    index index.html;

    location = /api {
        return 308 /api/;
    }

    # Keep the browser on one origin. Strip /api before forwarding because
    # the NestJS controllers currently serve /transactions, /categories, etc.
    location /api/ {
        proxy_pass http://127.0.0.1:3000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
